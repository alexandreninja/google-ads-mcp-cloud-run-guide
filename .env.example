# Copie somente os valores de configuração não confidenciais.
# Não inclua senhas, tokens, arquivos OAuth nem dados de contas.
#
# Identificador do projeto Google Cloud em que os recursos serão criados.
GOOGLE_CLOUD_PROJECT=SEU_PROJECT_ID

# Região e nomes utilizados pelos comandos de implantação.
REGION=us-central1
REPOSITORY=mcp-servers
SERVICE=google-ads-mcp
